-- SKIlark: Joy's kernel on Scott data, interpreted by a fold (PLAN.md).
-- This file is the kernel alone; skilark.joy appends generated programs.
-- It grows toward Joy in full; basis.ascii.ski keeps the basis alone, as
-- phase 3 measured it.  The words are Joy's (von Thun) and the basis follows
-- Kerby; `Do` is Joy's `i`, since `I` is reserved for the combinator.
-- `Qcons` is Joy's `cons`: `Cons` names the path constructor by SKIjack's
-- rule (SPEC section 8) and constructor names are global.
-- Quotations are data: `Quot` holds a program, not a function, so every
-- field is first-order and `Do` is a splice.  A quotation is also Joy's
-- list: its elements are items, a word among them a symbol (`Sym`), which
-- runs when it is spliced back.  Derived words are equations whose values
-- are programs: the program's own names are its dictionary.
-- Integers are signed and unbounded, a sign and a unary magnitude: `Pos m`
-- is m and `Neg m` is -(m+1), so zero is only `Pos Zero`.  A character is
-- its code, an integer, and a string the codes of its characters.  A set
-- is its members, the integers 0 to 63, distinct and ascending.
-- Joy's behaviour is the reference implementation's (Wodan58/Joy): its
-- tests take any value as a truth value, its comparisons order values of
-- different kinds, and a symbol has a name, which `=` and `<` compare.
-- A derived word inside a quotation is a `Def`, its name and its body: it
-- runs as its body and is read, as an element, as the symbol it names,
-- one of Joy's (`Named`) or one the program defines (`User`).
nat     === Zero | Suc nat
int     === Pos nat | Neg nat
logical === False | True
order   === Less | Same | More
text    === TNil | TCons int text
set     === SNil | SCons nat set
item    === Num int | Quot prog | Logical logical | Sym word | Char int | Str text | Set set
stack   === Empty | Push item stack
named   === Named text prog | User text prog
-- Avon jets a constructor of at most 32 arguments, and a one-field
-- constructor of an n-way sum takes n + 1, so word keeps to 31: the
-- kernel's further words are ext's, a sum of their own under one of word's
ext     === Size | At
word    === Dup | Swap | Pop | Qcons | Cat | Unit | Dip | Do | Lit item | Add | Sub | Mul | Div | Rem | Eql | Lt | Branch | Ifte | Uncons | Null | Small | Stack | Unstack | Def named | Ord | Chr | Typeof | Not | Choose stack | Ext ext
prog    === Done | Then word prog
result  === RVal stack | RErr | RTime

-- naturals, on skijack's numeral operations, which a runtime may run
-- natively on numerals it holds as words (avon DESIGN §6.10); each cases on
-- its numerals first, so a computed one is a word by then
add m n = m |> { Zero n; Suc i (n |> { Zero m; Suc j (natAdd m n) }) }
mul m n = m |> { Zero Zero; Suc i (n |> { Zero Zero; Suc j (natMul m n) }) }
less m n = n |> { Zero False; Suc j (m |> { Zero True; Suc i (natIfLe (Suc m) n True False) }) }
same m n = m |> { Zero (n |> { Zero True; Suc j False }); Suc i (n |> { Zero False; Suc j (natIfEq m n True False) }) }
monus m n = m |> { Zero Zero; Suc i (n |> { Zero m; Suc j (natSub m n) }) }
divN m n = m |> { Zero Zero; Suc i (n |> { Zero Zero; Suc j (natDiv m n) }) }
remN m n = m |> { Zero Zero; Suc i (n |> { Zero m; Suc j (natRem m n) }) }
-- truth values
flip a = a |> { False True; True False }
-- integers: -k, m - n of naturals, the magnitude.  An operation cases on
-- both its integers first, so their magnitudes reach it as numerals
negN k = k |> { Zero (Pos Zero); Suc j (Neg j) }
diff m n = m |> { Zero (negN n); Suc i (n |> { Zero (Pos m); Suc j (natIfLe n m (Pos (natSub m n)) (negN (natSub n m))) }) }
mag z = z |> { Pos m m; Neg m (Suc m) }
plus a b = a |> { Pos m (b |> { Pos n (Pos (add m n)); Neg n (diff m (Suc n)) }); Neg m (b |> { Pos n (diff n (Suc m)); Neg n (Neg (Suc (add m n))) }) }
minus z = z |> { Pos m (negN m); Neg m (Pos (Suc m)) }
times a b = a |> { Pos m (b |> { Pos n (Pos (mul m n)); Neg n (negN (mul m (Suc n))) }); Neg m (b |> { Pos n (negN (mul (Suc m) n)); Neg n (Pos (mul (Suc m) (Suc n))) }) }
-- division truncates toward zero and the remainder takes the dividend's sign
divide a b = a |> { Pos m (b |> { Pos n (Pos (divN m n)); Neg n (negN (divN m (Suc n))) }); Neg m (b |> { Pos n (negN (divN (Suc m) n)); Neg n (Pos (divN (Suc m) (Suc n))) }) }
modulo a b = a |> { Pos m (b |> { Pos n (Pos (remN m n)); Neg n (Pos (remN m (Suc n))) }); Neg m (b |> { Pos n (negN (remN (Suc m) n)); Neg n (negN (remN (Suc m) (Suc n))) }) }
-- Joy's null and small read a number as an aggregate: null is zero, small
-- is at most one (so every negative is small)
zero z = z |> { Pos m (m |> { Zero True; Suc k False }); Neg m False }
upToOne z = z |> { Pos m (m |> { Zero True; Suc k (k |> { Zero True; Suc j False }) }); Neg m True }
-- the reference's comparison (compare.h): two null values are the same;
-- numbers and truth values (false 0, true 1) by value; symbols by name;
-- anything else is More, in both orders
cmpN m n = m |> { Zero (n |> { Zero Same; Suc j Less }); Suc i (n |> { Zero More; Suc j (natIfEq m n Same (natIfLe m n Less More)) }) }
cmpZ a b = a |> { Pos m (b |> { Pos n (cmpN m n); Neg n More }); Neg m (b |> { Pos n Less; Neg n (cmpN n m) }) }
cmpT s t = s |> { TNil (t |> { TNil Same; TCons d u Less }); TCons c r (t |> { TNil More; TCons d u (cmpZ c d |> { Less Less; Same (cmpT r u); More More }) }) }
both a b = a |> { False False; True b }
boolZ b = b |> { False (Pos Zero); True (Pos n1) }
nullish x = x |> { Num z (zero z); Quot r (r |> { Done True; Then w p False }); Logical b (flip b); Sym w False; Char c (zero c); Str z (z |> { TNil True; TCons c r False }); Set z (z |> { SNil True; SCons m r False }) }
cmpI nm sc x y = x |> { Num m (y |> { Num n (cmpZ m n); Quot r More; Logical c (cmpZ m (boolZ c)); Sym v More; Char c (cmpZ m c); Str z More; Set v (sc x y) }); Quot r More; Logical b (y |> { Num n (cmpZ (boolZ b) n); Quot r More; Logical c (cmpZ (boolZ b) (boolZ c)); Sym v More; Char c (cmpZ (boolZ b) c); Str z More; Set v (sc x y) }); Sym w (y |> { Num n More; Quot r More; Logical c More; Sym v (cmpT (nm w) (nm v)); Char c More; Str z (cmpT (toCodes (nm w)) z); Set v More }); Char c (y |> { Num n (cmpZ c n); Quot r More; Logical d (cmpZ c (boolZ d)); Sym v More; Char d (cmpZ c d); Str z More; Set v (sc x y) }); Str z (y |> { Num n More; Quot r More; Logical c More; Sym v (cmpT z (toCodes (nm v))); Char c More; Str y (cmpT z y); Set v More }); Set z (y |> { Num n (sc x y); Quot r More; Logical c (sc x y); Sym v More; Char c (sc x y); Str w More; Set v (sc x y) }) }
compare x y = both (nullish x) (nullish y) |> { True Same; False (cmpI nameOf (setEq bitsOfI) x y) }
isSame o = o |> { Less False; Same True; More False }
isLess o = o |> { Less True; Same False; More False }
-- sets: a member put in, a union and the subset order, each a merge of
-- the ascending members, and the complement (Joy's not: k to 63, the
-- c numbers left); a
-- set and a number are the same when the number's 64 bits, two's
-- complement, are the set's members
insS x s = s |> { SNil (SCons x SNil); SCons y t (cmpN x y |> { Less (SCons x (SCons y t)); Same (SCons y t); More (SCons y (insS x t)) }) }
unionS s t = s |> { SNil t; SCons x r (t |> { SNil (SCons x r); SCons y u (cmpN x y |> { Less (SCons x (unionS r (SCons y u))); Same (SCons x (unionS r u)); More (SCons y (unionS (SCons x r) u)) }) }) }
subS s t = s |> { SNil True; SCons x r (t |> { SNil False; SCons y u (cmpN x y |> { Less False; Same (subS r u); More (subS (SCons x r) u) }) }) }
eqS s t = s |> { SNil (t |> { SNil True; SCons y u False }); SCons x r (t |> { SNil False; SCons y u (same x y |> { True (eqS r u); False False }) }) }
setEq bo x y = eqS (bo x) (bo y) |> { True Same; False More }
odd m = m |> { Zero False; Suc j (flip (odd j)) }
half m = m |> { Zero Zero; Suc j (j |> { Zero Zero; Suc i (Suc (half i)) }) }
bitsN k m = m |> { Zero SNil; Suc j (odd m |> { True (SCons k (bitsN (Suc k) (half m))); False (bitsN (Suc k) (half m)) }) }
complS k c s = c |> { Zero SNil; Suc d (s |> { SNil (SCons k (complS (Suc k) d SNil)); SCons x t (same k x |> { True (complS (Suc k) d t); False (SCons k (complS (Suc k) d (SCons x t))) }) }) }
compl s = complS Zero n64 s
bitsI z = z |> { Pos m (bitsN Zero m); Neg m (compl (bitsN Zero m)) }
boolS b = b |> { False SNil; True (SCons Zero SNil) }
n64 := mul n8 n8
-- the reference's < when either value is a set (comprel.h SETCMP): the
-- proper subset of the values' bits
isSet x = x |> { Num z False; Quot r False; Logical b False; Sym w False; Char c False; Str z False; Set z True }
bitsOf bi x = x |> { Num z (bi z); Quot r SNil; Logical b (boolS b); Sym w SNil; Char c (bi c); Str z SNil; Set z z }
bitsOfI x = bitsOf bitsI x
lessI cmp x y = (isSet x |> { True True; False (isSet y) }) |> { True (setLess (bitsOfI x) (bitsOfI y)); False (isLess (cmp x y)) }
setLess i j = both (flip (eqS i j)) (subS i j)
setCons ex q u n z = n |> { Pos m (less m n64 |> { True (ex q (Push (Set (insS m z)) u)); False RErr }); Neg m RErr }
-- a name's characters as codes, to compare with a string's (strcmp)
toCodes t = t |> { TNil TNil; TCons c r (TCons (c |> { Pos k (Pos (add a96 k)); Neg m (Pos (monus n62 m)) }) (toCodes r)) }
a96 := mul n8 n12
n62 := add (mul n6 n10) n2
catT y z = y |> { TNil z; TCons c r (TCons c (catT r z)) }
-- the reference's truth value of any value (boolean.h): zero and empty
-- are false, a symbol is true
truth x = x |> { Num z (flip (zero z)); Quot r (r |> { Done False; Then w p True }); Logical b b; Sym w True; Char c (flip (zero c)); Str z (z |> { TNil False; TCons c r True }); Set z (z |> { SNil False; SCons m r True }) }
cat p q = p |> { Done q; Then w r (Then w (cat r q)) }
-- a quotation's element as an item, and back: a literal is its value, any
-- other word a symbol.  Lit pushes any item, a symbol too: dip puts its
-- item back with Lit, so a symbol comes back as itself and does not run
itemOf w = w |> { Ord (Sym w); Chr (Sym w); Dup (Sym w); Swap (Sym w); Pop (Sym w); Qcons (Sym w); Cat (Sym w); Unit (Sym w); Dip (Sym w); Do (Sym w); Lit a a; Add (Sym w); Sub (Sym w); Mul (Sym w); Div (Sym w); Rem (Sym w); Eql (Sym w); Lt (Sym w); Branch (Sym w); Ifte (Sym w); Uncons (Sym w); Null (Sym w); Small (Sym w); Stack (Sym w); Unstack (Sym w); Def d (Sym w); Typeof (Sym w); Not (Sym w); Choose v (Sym w); Ext e (Sym w) }
wordOf a = a |> { Num n (Lit a); Quot r (Lit a); Logical b (Lit a); Sym w w; Char c (Lit a); Str z (Lit a); Set z (Lit a) }
-- the stack as a list, top first, and a list as the stack
toProg s = s |> { Empty Done; Push a t (Then (wordOf a) (toProg t)) }
fromProg r = r |> { Done Empty; Then w p (Push (itemOf w) (fromProg p)) }
-- names: a symbol's name, so that = and < compare two symbols as the
-- reference does, by name (a literal's word is never a symbol, and Choose
-- never stands in a quotation).  A name's characters are in a code that
-- keeps their order and costs little: a letter is its place in the
-- alphabet, an operator sign 62 less its character code, negated
n1 := Suc Zero
n2 := Suc n1
n3 := Suc n2
n4 := Suc n3
n5 := Suc n4
n6 := Suc n5
n7 := Suc n6
n8 := Suc n7
n9 := Suc n8
n10 := Suc n9
n11 := Suc n10
n12 := Suc n11
n13 := Suc n12
n14 := Suc n13
n15 := Suc n14
n16 := Suc n15
n17 := Suc n16
n18 := Suc n17
n19 := Suc n18
n20 := Suc n19
n21 := Suc n20
n22 := Suc n21
n23 := Suc n22
n24 := Suc n23
n25 := Suc n24
n26 := Suc n25
n27 := Suc n26
n28 := Suc n27
n29 := Suc n28
ca := Pos n1
cb := Pos n2
cc := Pos n3
cd := Pos n4
ce := Pos n5
cf := Pos n6
cg := Pos n7
ch := Pos n8
ci := Pos n9
cj := Pos n10
ck := Pos n11
cl := Pos n12
cm := Pos n13
cn := Pos n14
co := Pos n15
cp := Pos n16
cq := Pos n17
cr := Pos n18
cs := Pos n19
ct := Pos n20
cu := Pos n21
cv := Pos n22
cw := Pos n23
cx := Pos n24
cy := Pos n25
cz := Pos n26
cBang := Neg n29
cPlus := Neg n19
cMinus := Neg n17
cStar := Neg n20
cSlash := Neg n15
cLt := Neg n2
cEq := Neg n1
cGt := Neg Zero
nameOf w = w |> { Dup (TCons cd (TCons cu (TCons cp TNil))); Swap (TCons cs (TCons cw (TCons ca (TCons cp TNil)))); Pop (TCons cp (TCons co (TCons cp TNil))); Qcons (TCons cc (TCons co (TCons cn (TCons cs TNil)))); Cat (TCons cc (TCons ca (TCons ct TNil))); Unit (TCons cu (TCons cn (TCons ci (TCons ct TNil)))); Dip (TCons cd (TCons ci (TCons cp TNil))); Do (TCons ci TNil); Lit a TNil; Add (TCons cPlus TNil); Sub (TCons cMinus TNil); Mul (TCons cStar TNil); Div (TCons cSlash TNil); Rem (TCons cr (TCons ce (TCons cm TNil))); Eql (TCons cEq TNil); Lt (TCons cLt TNil); Branch (TCons cb (TCons cr (TCons ca (TCons cn (TCons cc (TCons ch TNil)))))); Ifte (TCons ci (TCons cf (TCons ct (TCons ce TNil)))); Uncons (TCons cu (TCons cn (TCons cc (TCons co (TCons cn (TCons cs TNil)))))); Null (TCons cn (TCons cu (TCons cl (TCons cl TNil)))); Small (TCons cs (TCons cm (TCons ca (TCons cl (TCons cl TNil))))); Stack (TCons cs (TCons ct (TCons ca (TCons cc (TCons ck TNil))))); Unstack (TCons cu (TCons cn (TCons cs (TCons ct (TCons ca (TCons cc (TCons ck TNil))))))); Def d (d |> { Named n b n; User n b n }); Ord (TCons co (TCons cr (TCons cd TNil))); Chr (TCons cc (TCons ch (TCons cr TNil))); Typeof (TCons ct (TCons cy (TCons cp (TCons ce (TCons co (TCons cf TNil)))))); Not (TCons cn (TCons co (TCons ct TNil))); Choose v TNil; Ext e (e |> { Size (TCons cs (TCons ci (TCons cz (TCons ce TNil)))); At (TCons ca (TCons ct TNil)) }) }

-- Joy's typeof (globals.h): a user-defined symbol 2, any other 3, a truth
-- value 4, a character 5, an integer 6, a set 7, a string 8, a list 9
kindOf a = a |> { Num z (Pos n6); Quot r (Pos n9); Logical b (Pos n4); Sym w (symKind w); Char c (Pos n5); Str z (Pos n8); Set z (Pos n7) }
symKind w = w |> { Def d (d |> { Named n b (Pos n3); User n b (Pos n2) }); Dup (Pos n3); Swap (Pos n3); Pop (Pos n3); Qcons (Pos n3); Cat (Pos n3); Unit (Pos n3); Dip (Pos n3); Do (Pos n3); Lit a (Pos n3); Add (Pos n3); Sub (Pos n3); Mul (Pos n3); Div (Pos n3); Rem (Pos n3); Eql (Pos n3); Lt (Pos n3); Branch (Pos n3); Ifte (Pos n3); Uncons (Pos n3); Null (Pos n3); Small (Pos n3); Stack (Pos n3); Unstack (Pos n3); Ord (Pos n3); Chr (Pos n3); Typeof (Pos n3); Not (Pos n3); Choose v (Pos n3); Ext e (Pos n3) }

-- the words' results, x below y on the stack
subZ n m = plus n (minus m)
mulI n m = Num (times n m)
divI n m = Num (divide n m)
remI n m = Num (modulo n m)
-- + and -: an integer on top, below it an integer or a character, which
-- the result takes the kind of
num2c f ex q s = s |> { Empty RErr; Push a t (t |> { Empty RErr; Push b u (a |> { Num m (b |> { Num n (ex q (Push (Num (f n m)) u)); Quot r RErr; Logical c RErr; Sym y RErr; Char c (ex q (Push (Char (f c m)) u)); Str xs RErr; Set st RErr }); Quot r RErr; Logical c RErr; Sym y RErr; Char xc RErr; Str xs RErr; Set st RErr }) }) }
-- a word of two numbers, and of two with a nonzero divisor
num2 f ex q s = s |> { Empty RErr; Push a t (t |> { Empty RErr; Push b u (a |> { Num m (b |> { Num n (ex q (Push (f n m) u)); Quot r RErr; Logical c RErr; Sym y RErr; Char xc RErr; Str xs RErr; Set st RErr }); Quot r RErr; Logical c RErr; Sym y RErr; Char xc RErr; Str xs RErr; Set st RErr }) }) }
div2 f ex q s = s |> { Empty RErr; Push a t (t |> { Empty RErr; Push b u (a |> { Num m (b |> { Num n (mag m |> { Zero RErr; Suc k (ex q (Push (f n m) u)) }); Quot r RErr; Logical c RErr; Sym y RErr; Char xc RErr; Str xs RErr; Set st RErr }); Quot r RErr; Logical c RErr; Sym y RErr; Char xc RErr; Str xs RErr; Set st RErr }) }) }

-- Fuel is a Church numeral: exec f runs at most f words, each one
-- unfolding of the loop's body (Done takes one more), and nothing is
-- decremented.  step takes the loop as a parameter: the expander ties
-- one fixpoint per equation and refuses mutual recursion.
exec f p s = f loop timeout p s
loop ex p s = p |> { Done (RVal s); Then w q (step ex w q s) }
timeout p s = RTime
-- ifte runs its test on the stack, then Choose takes the value it left as
-- a truth value and, from the stack it saved with the two branches on
-- top, restores the stack and splices the branch it picks.  The
-- comparison is bound once, so that the term holds one copy of it
step ex w q s = steps compare ex w q s
steps cmp ex w q s = w |> {
  Dup     (s |> { Empty RErr; Push a t (ex q (Push a (Push a t))) });
  Swap    (s |> { Empty RErr; Push a t (t |> { Empty RErr; Push b u (ex q (Push b (Push a u))) }) });
  Pop     (s |> { Empty RErr; Push a t (ex q t) });
  Qcons   (s |> { Empty RErr; Push a t (a |> { Num n RErr; Quot r (t |> { Empty RErr; Push b u (ex q (Push (Quot (Then (wordOf b) r)) u)) }); Logical c RErr; Sym y RErr; Char xc RErr; Str z (t |> { Empty RErr; Push b u (b |> { Num n RErr; Quot l RErr; Logical c RErr; Sym y RErr; Char c (ex q (Push (Str (TCons c z)) u)); Str xs RErr; Set st RErr }) }); Set z (t |> { Empty RErr; Push b u (b |> { Num n (setCons ex q u n z); Quot l RErr; Logical c RErr; Sym y RErr; Char c (setCons ex q u c z); Str xs RErr; Set st RErr }) }) }) });
  Cat     (s |> { Empty RErr; Push a t (a |> { Num n RErr; Quot r (t |> { Empty RErr; Push b u (b |> { Num m RErr; Quot l (ex q (Push (Quot (cat l r)) u)); Logical c RErr; Sym y RErr; Char xc RErr; Str xs RErr; Set st RErr }) }); Logical c RErr; Sym y RErr; Char xc RErr; Str z (t |> { Empty RErr; Push b u (b |> { Num m RErr; Quot l RErr; Logical c RErr; Sym y RErr; Char xc RErr; Str y (ex q (Push (Str (catT y z)) u)); Set st RErr }) }); Set z (t |> { Empty RErr; Push b u (b |> { Num m RErr; Quot l RErr; Logical c RErr; Sym y RErr; Char xc RErr; Str xs RErr; Set y (ex q (Push (Set (unionS y z)) u)) }) }) }) });
  Unit    (s |> { Empty RErr; Push a t (ex q (Push (Quot (Then (wordOf a) Done)) t)) });
  Dip     (s |> { Empty RErr; Push a t (a |> { Num n RErr; Quot r (t |> { Empty RErr; Push b u (ex (cat r (Then (Lit b) q)) u) }); Logical c RErr; Sym y RErr; Char xc RErr; Str xs RErr; Set st RErr }) });
  Do      (s |> { Empty RErr; Push a t (a |> { Num n RErr; Quot r (ex (cat r q) t); Logical c RErr; Sym y RErr; Char xc RErr; Str xs RErr; Set st RErr }) });
  Lit a   (ex q (Push a s));
  Add     (num2c plus ex q s);
  Sub     (num2c subZ ex q s);
  Mul     (num2 mulI ex q s);
  Div     (div2 divI ex q s);
  Rem     (div2 remI ex q s);
  Eql     (s |> { Empty RErr; Push a t (t |> { Empty RErr; Push b u (ex q (Push (Logical (isSame (cmp b a))) u)) }) });
  Lt      (s |> { Empty RErr; Push a t (t |> { Empty RErr; Push b u (ex q (Push (Logical (lessI cmp b a)) u)) }) });
  Branch  (s |> { Empty RErr; Push a t (a |> { Num n RErr; Quot f (t |> { Empty RErr; Push b u (b |> { Num n RErr; Quot r (u |> { Empty RErr; Push c v (truth c |> { False (ex (cat f q) v); True (ex (cat r q) v) }) }); Logical d RErr; Sym y RErr; Char xc RErr; Str xs RErr; Set st RErr }) }); Logical d RErr; Sym y RErr; Char xc RErr; Str xs RErr; Set st RErr }) });
  Ifte    (s |> { Empty RErr; Push a t (a |> { Num n RErr; Quot f (t |> { Empty RErr; Push b u (b |> { Num n RErr; Quot r (u |> { Empty RErr; Push c v (c |> { Num n RErr; Quot l (ex (cat l (Then (Choose (Push (Quot f) (Push (Quot r) v))) q)) v); Logical d RErr; Sym y RErr; Char xc RErr; Str xs RErr; Set st RErr }) }); Logical d RErr; Sym y RErr; Char xc RErr; Str xs RErr; Set st RErr }) }); Logical d RErr; Sym y RErr; Char xc RErr; Str xs RErr; Set st RErr }) });
  Uncons  (s |> { Empty RErr; Push a t (a |> { Num n RErr; Quot r (r |> { Done RErr; Then x p (ex q (Push (Quot p) (Push (itemOf x) t))) }); Logical c RErr; Sym y RErr; Char xc RErr; Str z (z |> { TNil RErr; TCons c r (ex q (Push (Str r) (Push (Char c) t))) }); Set z (z |> { SNil RErr; SCons m r (ex q (Push (Set r) (Push (Num (Pos m)) t))) }) }) });
  Null    (s |> { Empty RErr; Push a t (ex q (Push (Logical (nullish a)) t)) });
  Small   (s |> { Empty RErr; Push a t (a |> { Num n (ex q (Push (Logical (upToOne n)) t)); Quot r (ex q (Push (Logical (r |> { Done True; Then x p (p |> { Done True; Then x o False }) })) t)); Logical c (ex q (Push (Logical True) t)); Sym y RErr; Char c (ex q (Push (Logical (upToOne c)) t)); Str z (ex q (Push (Logical (z |> { TNil True; TCons c r (r |> { TNil True; TCons d o False }) })) t)); Set z (ex q (Push (Logical (z |> { SNil True; SCons m r (r |> { SNil True; SCons k o False }) })) t)) }) });
  Stack   (ex q (Push (Quot (toProg s)) s));
  Unstack (s |> { Empty RErr; Push a t (a |> { Num n RErr; Quot r (ex q (fromProg r)); Logical c RErr; Sym y RErr; Char xc RErr; Str xs RErr; Set st RErr }) });
  Def d   (d |> { Named n b (ex (cat b q) s); User n b (ex (cat b q) s) });
  Ord     (s |> { Empty RErr; Push a t (a |> { Num n (ex q (Push (Num n) t)); Quot r RErr; Logical b (ex q (Push (Num (boolZ b)) t)); Sym y RErr; Char c (ex q (Push (Num c) t)); Str xs RErr; Set st RErr }) });
  Chr     (s |> { Empty RErr; Push a t (a |> { Num n (ex q (Push (Char n) t)); Quot r RErr; Logical b (ex q (Push (Char (boolZ b)) t)); Sym y RErr; Char c (ex q (Push (Char c) t)); Str xs RErr; Set st RErr }) });
  Typeof  (s |> { Empty RErr; Push a t (ex q (Push (Num (kindOf a)) t)) });
  Not     (s |> { Empty RErr; Push a t (a |> { Num n (ex q (Push (Logical (zero n)) t)); Quot r RErr; Logical b (ex q (Push (Logical (flip b)) t)); Sym y RErr; Char c (ex q (Push (Logical (zero c)) t)); Str xs RErr; Set z (ex q (Push (Set (compl z)) t)) }) });
  Choose w (s |> { Empty RErr; Push a t (w |> { Empty RErr; Push x y (x |> { Num n RErr; Quot f (y |> { Empty RErr; Push z v (z |> { Num n RErr; Quot r (truth a |> { False (ex (cat f q) v); True (ex (cat r q) v) }); Logical e RErr; Sym g RErr; Char xc RErr; Str xs RErr; Set st RErr }) }); Logical e RErr; Sym g RErr; Char xc RErr; Str xs RErr; Set st RErr }) }) });
  Ext e   (exts e ex q s) }

-- ext's words.  size counts an aggregate's members; at takes an index,
-- an integer or a truth value, and the member there, its first at 0
exts e ex q s = e |> {
  Size (s |> { Empty RErr; Push a t (a |> { Num n RErr; Quot r (ex q (Push (Num (Pos (lenP r))) t)); Logical b RErr; Sym y RErr; Char c RErr; Str z (ex q (Push (Num (Pos (lenT z))) t)); Set z (ex q (Push (Num (Pos (lenS z))) t)) }) });
  At   (s |> { Empty RErr; Push i t (index i |> { Neg k RErr; Pos m (t |> { Empty RErr; Push a u (a |> { Num n RErr; Quot r (atP m r ex q u); Logical b RErr; Sym y RErr; Char c RErr; Str z (atT m z ex q u); Set z (atS m z ex q u) }) }) }) }) }
lenP r = r |> { Done Zero; Then w p (Suc (lenP p)) }
lenT z = z |> { TNil Zero; TCons c r (Suc (lenT r)) }
lenS z = z |> { SNil Zero; SCons m r (Suc (lenS r)) }
-- an index as an integer, and anything else as a negative one, which no
-- member has
index i = i |> { Num z z; Quot r (Neg Zero); Logical b (boolZ b); Sym y (Neg Zero); Char c (Neg Zero); Str z (Neg Zero); Set z (Neg Zero) }
atP m r ex q u = r |> { Done RErr; Then w p (m |> { Zero (ex q (Push (itemOf w) u)); Suc k (atP k p ex q u) }) }
atT m z ex q u = z |> { TNil RErr; TCons c r (m |> { Zero (ex q (Push (Char c) u)); Suc k (atT k r ex q u) }) }
atS m z ex q u = z |> { SNil RErr; SCons n r (m |> { Zero (ex q (Push (Num (Pos n)) u)); Suc k (atS k r ex q u) }) }

-- The same loop without fuel, for level 1: there the interpreter's
-- fuel bounds the run, so the object program needs none of its own.
execU p s = p |> { Done (RVal s); Then w q (step execU w q s) }

-- fuel: Church numerals, f applied n times; fuel is 10,000 words, room
-- for the derived combinators, which spend tens of words a level and
-- hundreds an element (construct, equal, split)
ten f x    = f (f (f (f (f (f (f (f (f (f x)))))))))
fuel f x   = ten (ten (ten (ten f))) x
